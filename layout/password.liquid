<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
    {% style %}
      {{ settings.type_header_font | font_face: font_display: 'swap' }}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      :root {
        --font-heading: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
        --font-heading-weight: {{ settings.type_header_font.weight }};
        --font-body: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --font-body-weight: {{ settings.type_body_font.weight }};
        --font-heading-scale: 1;
        --c-bg: {{ settings.color_background }};
        --c-surface: {{ settings.color_surface }};
        --c-surface-2: {{ settings.color_surface_alt }};
        --c-text: {{ settings.color_text }};
        --c-text-rgb: {{ settings.color_text.red }}, {{ settings.color_text.green }}, {{ settings.color_text.blue }};
        --c-muted: {{ settings.color_text | color_mix: settings.color_background, 78 }};
        --c-line: {{ settings.color_text | color_mix: settings.color_background, 14 }};
        --c-accent: {{ settings.color_accent }};
        --c-accent-contrast: {{ settings.color_accent_contrast }};
        --c-honey: {{ settings.color_honey }};
        --c-sage: {{ settings.color_sage }};
        --c-sale: {{ settings.color_sale }};
        --c-dark: {{ settings.color_dark }};
        --radius: {{ settings.radius }}px;
        --radius-sm: {{ settings.radius | divided_by: 2 }}px;
        --page-width: {{ settings.page_width }}px;
      }
    {% endstyle %}
    {{ 'obex.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>

<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    {%- liquid
      assign page_suffix = ''
      if current_tags
        assign page_suffix = page_suffix | append: ' – ' | append: current_tags.first
      endif
      if current_page != 1
        assign page_suffix = page_suffix | append: ' – ' | append: 'general.meta.page' | t: page: current_page
      endif
      # SEO per rynek: gdy w sklepie nie ma własnego meta tytułu/opisu, bierzemy frazy z pliku językowego (PL/IT/DA)
      assign seo_title = page_title
      assign seo_description = page_description
      if request.page_type == 'index'
        if page_title == shop.name or page_title == blank
          assign seo_title = 'seo.home_title' | t
        endif
        if page_description == blank
          assign seo_description = 'seo.home_description' | t
        endif
      elsif request.page_type == 'collection' and collection
        if page_title == collection.title
          assign seo_title = 'seo.collection_title' | t: title: collection.title
        endif
        if page_description == blank
          assign seo_description = 'seo.collection_description' | t: title: collection.title
        endif
      endif

      assign title_suffix = ''
      unless seo_title contains shop.name
        assign title_suffix = ' | ' | append: shop.name
      endunless
    -%}
    <title>{{ seo_title | append: page_suffix | append: title_suffix | strip }}</title>

    {%- if seo_description != blank -%}
      <meta name="description" content="{{ seo_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags', seo_title: seo_title, seo_description: seo_description %}

    {%- liquid
      assign header_font_bold = settings.type_header_font | font_modify: 'weight', '600'
      assign header_font_italic = settings.type_header_font | font_modify: 'style', 'italic'
      assign body_font_medium = settings.type_body_font | font_modify: 'weight', '500'
      assign body_font_bold = settings.type_body_font | font_modify: 'weight', '700'
      assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
    -%}
    {%- unless settings.type_header_font.system? -%}
      {{ settings.type_header_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {%- endunless -%}
    {%- unless settings.type_body_font.system? -%}
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {%- endunless -%}

    {% style %}
      {{ settings.type_header_font | font_face: font_display: 'swap' }}
      {{ header_font_bold | font_face: font_display: 'swap' }}
      {{ header_font_italic | font_face: font_display: 'swap' }}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ body_font_medium | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ body_font_italic | font_face: font_display: 'swap' }}

      :root {
        --font-heading: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
        --font-heading-weight: {{ settings.type_header_font.weight }};
        --font-body: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --font-body-weight: {{ settings.type_body_font.weight }};
        --font-heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};

        --c-bg: {{ settings.color_background }};
        --c-surface: {{ settings.color_surface }};
        --c-surface-2: {{ settings.color_surface_alt }};
        --c-text: {{ settings.color_text }};
        --c-text-rgb: {{ settings.color_text.red }}, {{ settings.color_text.green }}, {{ settings.color_text.blue }};
        --c-muted: {{ settings.color_text | color_mix: settings.color_background, 78 }};
        --c-line: {{ settings.color_text | color_mix: settings.color_background, 14 }};
        --c-accent: {{ settings.color_accent }};
        --c-accent-contrast: {{ settings.color_accent_contrast }};
        --c-honey: {{ settings.color_honey }};
        --c-sage: {{ settings.color_sage }};
        --c-sale: {{ settings.color_sale }};
        --c-dark: {{ settings.color_dark }};

        --radius: {{ settings.radius }}px;
        --radius-sm: {{ settings.radius | divided_by: 2 }}px;
        --page-width: {{ settings.page_width }}px;
        --card-ratio: {{ settings.card_image_ratio }};
      }
    {% endstyle %}

    {{ 'obex.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.Obex = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          search: {{ routes.search_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }}
        },
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          selectSize: {{ 'products.product.select_size' | t | json }},
          added: {{ 'products.product.added' | t | json }},
          error: {{ 'general.errors.generic' | t | json }},
          tooSmall: {{ 'size_guide.too_small' | t | json }},
          perfect: {{ 'size_guide.perfect' | t | json }},
          recommended: {{ 'size_guide.recommended_size' | t | json }},
          wishAdded: {{ 'wishlist.added' | t | json }},
          wishRemoved: {{ 'wishlist.removed' | t | json }}
        }
      };
    </script>
    <script src="{{ 'obex.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}--{{ template.suffix }}{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
      {%- if request.page_type == 'product' -%}
        {% sections 'product-extras' %}
      {%- endif -%}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}
    {%- unless request.page_type == 'product' -%}{% render 'size-guide-modal' %}{%- endunless -%}

    <div class="toast" role="status" aria-live="polite" hidden data-toast></div>

    {% render 'structured-data-site' %}
  </body>
</html>

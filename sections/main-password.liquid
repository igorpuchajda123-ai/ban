<section class="container notfound" style="min-height: 80vh; display:grid; place-content:center;">
  <p class="footer__brand-name" style="color: var(--c-text)">{{ shop.name }}</p>
  <h1>{{ 'password.heading' | t }}</h1>
  {%- if shop.password_message != blank -%}<p class="lead" style="margin-inline:auto">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'customer', class: 'newsletter__form', style: 'max-width:28rem; margin: 2rem auto 0;' -%}
    <input type="hidden" name="contact[tags]" value="prospect,password-page">
    {%- if form.posted_successfully? -%}<p class="form-message form-message--success">{{ 'newsletter.success' | t }}</p>{%- endif -%}
    <input type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" required aria-label="{{ 'newsletter.email' | t }}">
    <button class="btn" type="submit">{{ 'password.notify' | t }}</button>
  {%- endform -%}
  <details style="margin-top:3rem">
    <summary class="small muted" style="cursor:pointer">{{ 'password.owner' | t }}</summary>
    {%- form 'storefront_password', class: 'newsletter__form', style: 'max-width:28rem; margin: 1rem auto 0;' -%}
      <input type="password" name="password" placeholder="{{ 'password.password' | t }}" aria-label="{{ 'password.password' | t }}">
      <button class="btn" type="submit">{{ 'password.enter' | t }}</button>
    {%- endform -%}
  </details>
</section>

{% schema %}
{ "name": "Hasło", "settings": [] }
{% endschema %}

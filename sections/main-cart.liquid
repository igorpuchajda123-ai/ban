<div class="container container--wide section" style="--pad-top: 24px;">
  <div data-cart-page data-section="{{ section.id }}">
    <h1>{{ 'cart.title' | t }}</h1>
    {%- if cart.item_count > 0 -%}
      <div class="cart-page">
        <div>
          {%- for item in cart.items -%}
            <div class="cart-item" data-key="{{ item.key }}">
              <a class="cart-item__img" href="{{ item.url }}" tabindex="-1">{%- if item.image -%}{{ item.image | image_url: width: 300 | image_tag: loading: 'eager', alt: item.product.title }}{%- endif -%}</a>
              <div>
                <div class="cart-item__row" style="align-items:flex-start">
                  <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
                  <span style="font-weight:500; text-align:right">{%- if item.original_line_price > item.final_line_price -%}<s class="muted" style="display:block; font-weight:400; font-size:.85rem">{{ item.original_line_price | money }}</s>{%- endif -%}{{ item.final_line_price | money }}</span>
                </div>
                <p class="cart-item__meta">
                  {%- unless item.product.has_only_default_variant -%}{%- for option in item.options_with_values -%}{%- assign opt_name = option.name | downcase -%}{%- if 'rozmiar,size,shoe size,rozmiar buta,taglia,misura,størrelse,storrelse,str.,eu' contains opt_name -%}{{ 'products.product.size' | t }}{%- else -%}{{ option.name }}{%- endif -%}: {{ option.value }}{% unless forloop.last %} · {% endunless %}{%- endfor -%}{%- endunless -%}
                  · {{ item.final_price | money }}
                </p>
                <div class="cart-item__row">
                  <div class="qty">
                    <button type="button" data-cart-qty="{{ item.key }}" data-qty="{{ item.quantity | minus: 1 }}" aria-label="{{ 'products.product.quantity_decrease' | t }}">{% render 'icon', name: 'minus' %}</button>
                    <input type="number" value="{{ item.quantity }}" min="0" data-cart-input="{{ item.key }}" aria-label="{{ 'products.product.quantity' | t }}">
                    <button type="button" data-cart-qty="{{ item.key }}" data-qty="{{ item.quantity | plus: 1 }}" aria-label="{{ 'products.product.quantity_increase' | t }}">{% render 'icon', name: 'plus' %}</button>
                  </div>
                  <button type="button" class="cart-item__remove" data-cart-qty="{{ item.key }}" data-qty="0">{{ 'cart.remove' | t }}</button>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
        <aside class="cart-page__summary">
          {% render 'free-shipping-bar' %}
          <div style="margin-top:1.25rem">{% render 'cart-discount', id: 'page' %}</div>
          <form action="{{ routes.cart_url }}" method="post" id="CartForm" style="margin-top:1.25rem">
            {%- if section.settings.show_note -%}
              <label class="field" style="margin-bottom:1.25rem">
                <span>{{ 'cart.note' | t }}</span>
                <textarea class="textarea" name="note" style="min-height:5rem">{{ cart.note }}</textarea>
              </label>
            {%- endif -%}
            {%- for discount in cart.cart_level_discount_applications -%}
              <div class="cart-total" style="font-size:.9rem; font-weight:400"><span>{{ discount.title }}</span><span>−{{ discount.total_allocated_amount | money }}</span></div>
            {%- endfor -%}
            <div class="cart-total"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money_with_currency }}</span></div>
            <p class="cart-note">{%- if cart.taxes_included -%}{{ 'cart.taxes_included_shipping' | t }}{%- else -%}{{ 'cart.taxes_shipping' | t }}{%- endif -%}</p>
            <button type="submit" name="checkout" class="btn btn--block btn--lg">{% render 'icon', name: 'lock' %} {{ 'cart.checkout' | t }}</button>
            {%- if additional_checkout_buttons and section.settings.show_express -%}
              <div style="margin-top:.75rem">{{ content_for_additional_checkout_buttons }}</div>
            {%- endif -%}
          </form>
          <ul class="payment-icons" role="list" style="margin-top:1.25rem; justify-content:center">
            {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
          </ul>
        </aside>
      </div>
    {%- else -%}
      <div class="cart-empty">
        {% render 'icon', name: 'foot' %}
        <p class="h3" style="margin:0">{{ 'cart.empty' | t }}</p>
        <p class="muted" style="margin:0">{{ 'cart.empty_text' | t }}</p>
        <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Koszyk",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "Uwagi do zamówienia", "default": true },
    { "type": "checkbox", "id": "show_express", "label": "Szybkie płatności", "default": true }
  ]
}
{% endschema %}

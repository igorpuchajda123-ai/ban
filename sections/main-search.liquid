<div class="container container--wide">
  {% render 'breadcrumbs' %}
  <header class="collection-hero">
    <p class="eyebrow">{{ 'search.title' | t }}</p>
    <h1>{%- if search.performed -%}{{ 'search.results_for' | t: terms: search.terms }}{%- else -%}{{ 'search.title' | t }}{%- endif -%}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form" style="max-width: 40rem; margin-top: 1.5rem;">
      {% render 'icon', name: 'search' %}
      <label class="visually-hidden" for="SearchPageInput">{{ 'header.search' | t }}</label>
      <input type="search" id="SearchPageInput" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
      <input type="hidden" name="type" value="product">
    </form>
  </header>

  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <div class="toolbar"><span class="toolbar__count">{{ 'collection.product_count' | t: count: search.results_count }}</span></div>
      {%- if search.results_count > 0 -%}
        <div class="product-grid" style="--cols: 4;">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item, heading_level: 'h2' %}
            {%- else -%}
              <a class="article-card" href="{{ item.url }}">
                <span class="article-card__meta">{{ item.object_type }}</span>
                <h2 class="h3">{{ item.title }}</h2>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <div class="cart-empty"><p class="h3">{{ 'search.no_results' | t: terms: search.terms }}</p><a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a></div>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>
<div style="height: 5rem"></div>

{% schema %}
{ "name": "Wyniki wyszukiwania", "settings": [] }
{% endschema %}

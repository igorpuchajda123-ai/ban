{%- liquid
  assign d_eyebrow = 'sections.faq.eyebrow' | t
  assign d_heading = 'sections.faq.heading_html' | t
  assign d_text = 'sections.faq.text' | t
-%}
<section class="section{% if section.settings.surface %} section--surface{% endif %}" style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;" {{ section.shopify_attributes }}>
  <div class="container container--wide faq">
    <div class="faq__aside reveal">
      <p class="eyebrow">{{ section.settings.eyebrow | default: d_eyebrow }}</p>
      <h2>{{ section.settings.heading | default: d_heading }}</h2>
      <p class="lead">{{ section.settings.text | default: d_text }}</p>
      {%- if section.settings.show_contact -%}
        <a class="link-arrow" href="{{ section.settings.contact_link | default: '/pages/contact' }}">{{ 'sections.faq.contact' | t }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
    <div class="accordion reveal" data-delay="1">
      {%- for block in section.blocks -%}
        {%- liquid
          assign base = 'faq.' | append: block.settings.preset
          if block.settings.preset == 'custom'
            assign d_q = ''
            assign d_a = ''
          else
            assign d_q = base | append: '.q' | t
            assign d_a = base | append: '.a_html' | t
          endif
        -%}
        <details {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary>
            <span>{{ block.settings.question | default: d_q }}</span>
            <span class="accordion__icon">{% render 'icon', name: 'plus' %}</span>
          </summary>
          <div class="accordion__content rte">{{ block.settings.answer | default: d_a }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.settings.schema and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {%- liquid
            assign base = 'faq.' | append: block.settings.preset
            if block.settings.preset == 'custom'
              assign d_q = ''
              assign d_a = ''
            else
              assign d_q = base | append: '.q' | t
              assign d_a = base | append: '.a_html' | t
            endif
            assign q = block.settings.question | default: d_q
            assign a = block.settings.answer | default: d_a
          -%}
          {
            "@type": "Question",
            "name": {{ q | strip_html | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ a | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł", "info": "Puste = tekst domyślny (PL/IT/DA)." },
    { "type": "inline_richtext", "id": "heading", "label": "Nagłówek" },
    { "type": "text", "id": "text", "label": "Opis" },
    { "type": "checkbox", "id": "show_contact", "label": "Link do kontaktu", "default": true },
    { "type": "url", "id": "contact_link", "label": "Strona kontaktu" },
    { "type": "checkbox", "id": "open_first", "label": "Otwórz pierwsze pytanie", "default": false },
    { "type": "checkbox", "id": "schema", "label": "Dane strukturalne FAQ (SEO)", "default": true, "info": "Włącz tylko w jednej sekcji FAQ na stronie." },
    { "type": "checkbox", "id": "surface", "label": "Beżowe tło", "default": false },
    { "type": "range", "id": "padding_top", "label": "Odstęp górny", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Odstęp dolny", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Pytanie",
      "settings": [
        { "type": "select", "id": "preset", "label": "Gotowe pytanie (PL/IT/DA)", "options": [
          { "value": "size", "label": "Jaki rozmiar wybrać?" },
          { "value": "care", "label": "Jak dbać o buty?" },
          { "value": "sole", "label": "Dlaczego podeszwa jest cienka?" },
          { "value": "wide", "label": "Pulchna stopa / wysokie podbicie" },
          { "value": "returns", "label": "Zwroty i wymiany" },
          { "value": "shipping", "label": "Wysyłka za granicę" },
          { "value": "indoor_outdoor", "label": "Indoor czy outdoor?" },
          { "value": "first_steps", "label": "Od kiedy buty barefoot?" },
          { "value": "custom", "label": "Własne (pola poniżej)" }
        ], "default": "size" },
        { "type": "text", "id": "question", "label": "Własne pytanie" },
        { "type": "richtext", "id": "answer", "label": "Własna odpowiedź" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ", "blocks": [
    { "type": "question", "settings": { "preset": "size" } },
    { "type": "question", "settings": { "preset": "sole" } },
    { "type": "question", "settings": { "preset": "wide" } },
    { "type": "question", "settings": { "preset": "returns" } }
  ] }]
}
{% endschema %}

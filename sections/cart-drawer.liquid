{%- comment -%}
  Koszyk w szufladzie. Renderowany przez Section Rendering API po każdej zmianie (obex.js).
{%- endcomment -%}
<div class="drawer drawer--right cart-drawer" id="CartDrawer" data-drawer aria-hidden="true">
  <button class="drawer__overlay" type="button" data-drawer-close tabindex="-1" aria-label="{{ 'general.close' | t }}"></button>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle">
    <div class="drawer__head">
      <h2 class="drawer__title" id="CartDrawerTitle">{{ 'cart.title' | t }} {% if cart.item_count > 0 %}<span class="muted" style="font-size:1rem">({{ cart.item_count }})</span>{% endif %}</h2>
      <button class="icon-btn" type="button" data-drawer-close>{% render 'icon', name: 'close' %}<span class="visually-hidden">{{ 'general.close' | t }}</span></button>
    </div>

    {%- if cart.item_count > 0 -%}
      {% render 'free-shipping-bar' %}
      <div class="drawer__body">
        {%- for item in cart.items -%}
          <div class="cart-item" data-line="{{ forloop.index }}">
            <a class="cart-item__img" href="{{ item.url }}" tabindex="-1">
              {%- if item.image -%}{{ item.image | image_url: width: 220 | image_tag: loading: 'lazy', alt: item.product.title }}{%- endif -%}
            </a>
            <div>
              <div class="cart-item__row" style="align-items:flex-start">
                <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
                <span style="font-weight:500; white-space:nowrap">{{ item.final_line_price | money }}</span>
              </div>
              <p class="cart-item__meta">
                {%- unless item.product.has_only_default_variant -%}
                  {%- for option in item.options_with_values -%}{{ option.name }}: {{ option.value }}{% unless forloop.last %} · {% endunless %}{%- endfor -%}
                {%- endunless -%}
                {%- for discount in item.line_level_discount_allocations -%}<br>{{ discount.discount_application.title }} (−{{ discount.amount | money }}){%- endfor -%}
              </p>
              <div class="cart-item__row">
                <div class="qty">
                  <button type="button" data-cart-qty="{{ forloop.index }}" data-qty="{{ item.quantity | minus: 1 }}" aria-label="{{ 'products.product.quantity_decrease' | t }}">{% render 'icon', name: 'minus' %}</button>
                  <input type="number" value="{{ item.quantity }}" min="0" data-cart-input="{{ forloop.index }}" aria-label="{{ 'products.product.quantity' | t }}">
                  <button type="button" data-cart-qty="{{ forloop.index }}" data-qty="{{ item.quantity | plus: 1 }}" aria-label="{{ 'products.product.quantity_increase' | t }}">{% render 'icon', name: 'plus' %}</button>
                </div>
                <button type="button" class="cart-item__remove" data-cart-qty="{{ forloop.index }}" data-qty="0">{{ 'cart.remove' | t }}</button>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
      <div class="drawer__foot">
        {%- for discount in cart.cart_level_discount_applications -%}
          <div class="cart-total" style="font-size:.9rem; font-weight:400"><span>{{ discount.title }}</span><span>−{{ discount.total_allocated_amount | money }}</span></div>
        {%- endfor -%}
        <div class="cart-total"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money_with_currency }}</span></div>
        <p class="cart-note">
          {%- if cart.taxes_included -%}{{ 'cart.taxes_included_shipping' | t }}{%- else -%}{{ 'cart.taxes_shipping' | t }}{%- endif -%}
        </p>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="btn btn--block btn--lg">{% render 'icon', name: 'lock' %} {{ 'cart.checkout' | t }}</button>
        </form>
        <a class="link-arrow" style="margin-top:1rem; font-size:.85rem" href="{{ routes.cart_url }}">{{ 'cart.view_cart' | t }} {% render 'icon', name: 'arrow' %}</a>
      </div>
    {%- else -%}
      <div class="drawer__body">
        <div class="cart-empty">
          {% render 'icon', name: 'foot' %}
          <p class="h3" style="margin:0">{{ 'cart.empty' | t }}</p>
          <p class="muted" style="margin:0">{{ 'cart.empty_text' | t }}</p>
          <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Koszyk (szuflada)",
  "settings": []
}
{% endschema %}

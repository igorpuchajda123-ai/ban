{%- comment -%}
  Karta produktu. Parametry: product, lazy (bool, domyślnie true), sizes (atrybut sizes obrazu), heading_level ('h2'/'h3')
{%- endcomment -%}
{%- liquid
  assign img_1 = product.featured_media.preview_image
  assign img_2 = nil
  if settings.card_hover_image and product.media.size > 1
    assign img_2 = product.media[1].preview_image
  endif
  assign img_sizes = sizes | default: '(min-width: 990px) 25vw, 50vw'
  assign loading = 'lazy'
  if lazy == false
    assign loading = 'eager'
  endif
  assign tag = heading_level | default: 'h3'

  assign first_size = product.variants.first.option1
  assign last_size = product.variants.last.option1
-%}
<article class="card">
  <a href="{{ product.url }}" class="card__media{% if settings.card_image_fit == 'contain' %} card__media--contain{% endif %}" tabindex="-1" aria-hidden="true">
    {%- if img_1 -%}
      {{ img_1 | image_url: width: 900 | image_tag:
        widths: '300, 450, 600, 750, 900',
        sizes: img_sizes,
        loading: loading,
        alt: img_1.alt | default: product.title,
        class: 'card__img-1'
      }}
      {%- if img_2 -%}
        {{ img_2 | image_url: width: 900 | image_tag:
          widths: '300, 450, 600, 750, 900',
          sizes: img_sizes,
          loading: 'lazy',
          alt: '',
          class: 'card__img-2'
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </a>

  <div class="card__badges">
    {%- if product.available == false -%}
      <span class="badge badge--soldout">{{ 'products.product.sold_out' | t }}</span>
    {%- elsif product.compare_at_price > product.price -%}
      <span class="badge badge--sale">{{ 'products.product.on_sale' | t }}</span>
    {%- endif -%}
    {%- if settings.badge_new_tag != blank and product.tags contains settings.badge_new_tag -%}
      <span class="badge badge--new">{{ 'products.product.new' | t }}</span>
    {%- elsif settings.badge_wide_tag != blank and product.tags contains settings.badge_wide_tag -%}
      <span class="badge">WIDE</span>
    {%- endif -%}
  </div>

  {%- if settings.card_quick_link and product.available -%}
    <div class="card__quick">
      <a class="btn" href="{{ product.url }}">{{ 'products.product.choose_size' | t }}</a>
    </div>
  {%- endif -%}

  <div class="card__info">
    {%- if settings.card_show_vendor -%}
      <span class="card__vendor">{{ product.vendor }}</span>
    {%- endif -%}
    <{{ tag }} class="card__title">
      <a href="{{ product.url }}">{{ product.title | escape }}</a>
    </{{ tag }}>
    {% render 'price', product: product %}
    {%- if settings.card_show_sizes and product.variants.size > 1 -%}
      <span class="card__sizes">{{ 'products.product.sizes_range' | t: from: first_size, to: last_size }}</span>
    {%- endif -%}
    {%- if settings.card_show_swatches and product.metafields.custom.rodzina_produktow != blank -%}
      {%- assign family = product.metafields.custom.rodzina_produktow.value -%}
      {%- if family.products_count > 1 -%}
        <div class="card__swatches" aria-label="{{ 'products.product.colors_count' | t: count: family.products_count }}">
          {%- for sibling in family.products limit: 5 -%}
            <a class="card__swatch" href="{{ sibling.url }}" title="{{ sibling.title | escape }}">
              {{ sibling.featured_image | image_url: width: 64, height: 64, crop: 'center' | image_tag: loading: 'lazy', alt: sibling.title }}
            </a>
          {%- endfor -%}
          {%- if family.products_count > 5 -%}
            <span class="card__swatch-more">+{{ family.products_count | minus: 5 }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</article>

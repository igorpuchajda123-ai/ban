{%- comment -%}
  Pasek darmowej dostawy – próg ustawiany osobno dla każdego rynku (waluty) w Ustawieniach motywu.
{%- endcomment -%}
{%- liquid
  case localization.country.iso_code
    when 'PL'
      assign threshold = settings.free_shipping_pl
    when 'IT'
      assign threshold = settings.free_shipping_it
    when 'DK'
      assign threshold = settings.free_shipping_dk
    else
      assign threshold = settings.free_shipping_other
  endcase
  assign threshold_cents = threshold | default: 0 | times: 100
-%}
{%- if threshold_cents > 0 -%}
  {%- liquid
    assign total = cart.items_subtotal_price
    assign remaining = threshold_cents | minus: total
    assign pct = total | times: 100 | divided_by: threshold_cents | at_most: 100
  -%}
  <div class="ship-bar" data-ship-bar>
    {%- if remaining > 0 -%}
      {%- assign remaining_money = remaining | money -%}
      <span>{{ 'cart.free_shipping_remaining_html' | t: amount: remaining_money }}</span>
    {%- else -%}
      <span>{{ 'cart.free_shipping_reached_html' | t }}</span>
    {%- endif -%}
    <div class="ship-bar__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct }}" aria-label="{{ 'cart.free_shipping_progress' | t }}">
      <div class="ship-bar__fill" style="width: {{ pct }}%;"></div>
    </div>
  </div>
{%- endif -%}

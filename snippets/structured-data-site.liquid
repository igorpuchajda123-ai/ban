{%- comment -%}
  Organization + WebSite (z wyszukiwarką) – tylko na stronie głównej.
  hreflang dla rynków i języków Shopify dodaje automatycznie w content_for_header.
{%- endcomment -%}
{%- if request.page_type == 'index' -%}
  {%- liquid
    assign same_as = ''
    assign platforms = 'facebook,instagram,tiktok,youtube,pinterest' | split: ','
    for platform in platforms
      assign key = 'social_' | append: platform | append: '_link'
      if settings[key] != blank
        assign same_as = same_as | append: settings[key] | append: '|'
      endif
    endfor
    assign same_as = same_as | split: '|'
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": {{ shop.url | append: '/#organization' | json }},
          "name": {{ shop.name | json }},
          "url": {{ shop.url | json }},
          {%- if settings.logo != blank %}
          "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},
          {%- endif %}
          {%- if shop.email != blank %}
          "email": {{ shop.email | json }},
          {%- endif %}
          {%- if settings.contact_phone != blank %}
          "telephone": {{ settings.contact_phone | json }},
          {%- endif %}
          "sameAs": {{ same_as | json }}
        },
        {
          "@type": "WebSite",
          "@id": {{ shop.url | append: '/#website' | json }},
          "name": {{ shop.name | json }},
          "url": {{ request.origin | append: routes.root_url | json }},
          "inLanguage": {{ request.locale.iso_code | json }},
          "publisher": { "@id": {{ shop.url | append: '/#organization' | json }} },
          "potentialAction": {
            "@type": "SearchAction",
            {%- assign search_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' -%}
            "target": {{ search_target | json }},
            "query-input": "required name=search_term_string"
          }
        }
      ]
    }
  </script>
{%- endif -%}

{%- comment -%}
  Cena w walucie rynku (PLN / EUR / DKK) – Shopify przelicza automatycznie wg Markets.
  Parametry: product (wymagany), variant (opcjonalny), class (opcjonalny)
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign is_range = false
  if variant == blank and product.price_varies
    assign is_range = true
  endif
  assign on_sale = false
  if target.compare_at_price > target.price
    assign on_sale = true
  endif
-%}
<div class="price {{ class }}" data-price>
  {%- if on_sale -%}
    <span class="visually-hidden">{{ 'products.product.sale_price' | t }}</span>
    <span class="price__sale">{{ target.price | money }}</span>
    <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
    <s class="price__compare">{{ target.compare_at_price | money }}</s>
  {%- else -%}
    <span>
      {%- if is_range -%}
        {%- assign price_min = product.price_min | money -%}
        {{ 'products.product.price_from_html' | t: price: price_min }}
      {%- else -%}
        {{ target.price | money }}
      {%- endif -%}
    </span>
  {%- endif -%}
  {%- if target.unit_price_measurement -%}
    <span class="price__unit">
      {{ target.unit_price | money }}/
      {%- if target.unit_price_measurement.reference_value != 1 -%}{{ target.unit_price_measurement.reference_value }}{%- endif -%}
      {{ target.unit_price_measurement.reference_unit }}
    </span>
  {%- endif -%}
</div>

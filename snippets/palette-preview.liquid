{%- comment -%}
  Tymczasowy podgląd propozycji czcionek.
  Działa tylko w podglądzie nieopublikowanego motywu (po publikacji sam znika).
  Link: ?preview_theme_id=…&czcionka=a | b | c | d | obecna
{%- endcomment -%}
{%- unless theme.role == 'main' -%}
<style>
  .pal-switch{position:fixed;left:12px;bottom:96px;z-index:9999;font:500 13px/1.2 system-ui,sans-serif}
  .pal-switch__toggle{display:flex;align-items:center;gap:6px;padding:10px 14px;border:0;border-radius:999px;background:#111;color:#fff;box-shadow:0 6px 20px rgba(0,0,0,.25);cursor:pointer;font:inherit}
  .pal-switch__list{display:none;flex-direction:column;gap:6px;margin-bottom:8px}
  .pal-switch.is-open .pal-switch__list{display:flex}
  .pal-switch__opt{display:flex;flex-direction:column;align-items:flex-start;gap:2px;padding:8px 14px;border:2px solid transparent;border-radius:16px;background:#fff;color:#111;box-shadow:0 4px 14px rgba(0,0,0,.18);cursor:pointer;font:inherit;text-align:left}
  .pal-switch__opt[aria-pressed="true"]{border-color:#111}
  .pal-switch__opt b{font-size:17px;font-weight:600}
  .pal-switch__opt small{font-size:11px;opacity:.65}
</style>
<script>
  (function () {
    var F = {
      obecna: { name: 'Obecna', desc: 'Fraunces + DM Sans', fh: 'Fraunces', fb: 'DM Sans' },
      a: { name: 'A. Klasyczna', desc: 'Lora + Nunito Sans', fh: 'Lora', fhw: 500, fb: 'Nunito Sans', q: 'family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Nunito+Sans:wght@400;500;600;700' },
      b: { name: 'B. Elegancka', desc: 'Playfair Display + Jost', fh: 'Playfair Display', fhw: 500, fb: 'Jost', q: 'family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Jost:wght@400;500;600;700' },
      c: { name: 'C. Nowoczesna', desc: 'Jost', fh: 'Jost', fhw: 500, fb: 'Jost', q: 'family=Jost:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500' },
      d: { name: 'D. Przyjazna', desc: 'Nunito + Nunito Sans', fh: 'Nunito', fhw: 700, fb: 'Nunito Sans', q: 'family=Nunito:ital,wght@0,400;0,600;0,700;0,800;1,600;1,700&family=Nunito+Sans:wght@400;500;600;700' }
    };
    var KEY = 'obex:czcionka';
    var store = { get: function () { try { return sessionStorage.getItem(KEY); } catch (e) { return null; } }, set: function (v) { try { sessionStorage.setItem(KEY, v); } catch (e) {} } };
    var fromUrl = new URLSearchParams(location.search).get('czcionka');
    if (fromUrl && F[fromUrl]) store.set(fromUrl);
    var root = document.documentElement;
    var initial = root.style.cssText;
    function load(id) {
      var f = F[id];
      if (!f.q || document.getElementById('pal-fonts-' + id)) return;
      var link = document.createElement('link'); link.id = 'pal-fonts-' + id; link.rel = 'stylesheet';
      link.href = 'https://fonts.googleapis.com/css2?' + f.q + '&display=swap'; document.head.appendChild(link);
    }
    function apply(id) {
      var f = F[id] || F.obecna;
      root.style.cssText = initial;
      if (!f.q) return;
      load(id);
      root.style.setProperty('--font-heading', "'" + f.fh + "', Georgia, serif");
      root.style.setProperty('--font-heading-weight', f.fhw);
      root.style.setProperty('--font-body', "'" + f.fb + "', system-ui, sans-serif");
    }
    var current = store.get() || 'obecna';
    apply(current);
    document.addEventListener('DOMContentLoaded', function () {
      var box = document.createElement('div'); box.className = 'pal-switch';
      var list = document.createElement('div'); list.className = 'pal-switch__list';
      Object.keys(F).forEach(function (id) {
        var f = F[id], b = document.createElement('button'); b.type = 'button'; b.className = 'pal-switch__opt'; b.dataset.id = id;
        load(id);
        b.innerHTML = '<b style="font-family:\'' + f.fh + '\',serif">' + f.name + '</b><small>' + f.desc + '</small>';
        b.setAttribute('aria-pressed', String(id === current));
        b.addEventListener('click', function () { current = id; store.set(id); apply(id); list.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', String(x.dataset.id === id)); }); });
        list.appendChild(b);
      });
      var t = document.createElement('button'); t.type = 'button'; t.className = 'pal-switch__toggle'; t.textContent = 'Czcionka: zmień';
      t.addEventListener('click', function () { box.classList.toggle('is-open'); });
      box.appendChild(list); box.appendChild(t); document.body.appendChild(box);
    });
  })();
</script>
{%- endunless -%}

{%- comment -%}
  Tymczasowy podgląd propozycji kolorów i czcionek.
  Działa tylko w podglądzie nieopublikowanego motywu (po publikacji sam znika).
  Link: ?preview_theme_id=…&paleta=granat | szalwia | malina | lawenda | obecna
{%- endcomment -%}
{%- unless theme.role == 'main' -%}
<style>
  .pal-switch{position:fixed;left:12px;bottom:96px;z-index:9999;font:500 13px/1.2 system-ui,sans-serif}
  .pal-switch__toggle{display:flex;align-items:center;gap:6px;padding:10px 14px;border:0;border-radius:999px;background:#111;color:#fff;box-shadow:0 6px 20px rgba(0,0,0,.25);cursor:pointer;font:inherit}
  .pal-switch__list{display:none;flex-direction:column;gap:6px;margin-bottom:8px}
  .pal-switch.is-open .pal-switch__list{display:flex}
  .pal-switch__opt{display:flex;align-items:center;gap:8px;padding:8px 12px;border:2px solid transparent;border-radius:999px;background:#fff;color:#111;box-shadow:0 4px 14px rgba(0,0,0,.18);cursor:pointer;font:inherit;text-align:left}
  .pal-switch__opt[aria-pressed="true"]{border-color:#111}
  .pal-switch__dots{display:flex}
  .pal-switch__dots i{width:14px;height:14px;border-radius:50%;margin-right:-4px;border:1px solid rgba(0,0,0,.15)}
</style>
<script>
  (function () {
    var P = {
      obecna: { name: 'Obecna – brąz i krem' },
      granat: { name: '1. Granat i len', bg: '#F6F4F0', surface: '#E8EDF2', surface2: '#D6E0EA', text: '#16212E', accent: '#1F3B5C', honey: '#C49A6C', sage: '#7F9C93', sale: '#B4532A', dark: '#14202E', fh: 'Lora', fhw: 500, fb: 'Nunito Sans', q: 'family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Nunito+Sans:wght@400;500;600;700' },
      szalwia: { name: '2. Szałwia i terakota', bg: '#F5F2EA', surface: '#E6E8DC', surface2: '#D5DCC7', text: '#26291F', accent: '#4C5E43', honey: '#C2734B', sage: '#8DA27C', sale: '#B4532A', dark: '#2B3427', fh: 'Playfair Display', fhw: 500, fb: 'Karla', q: 'family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Karla:wght@400;500;600;700' },
      malina: { name: '3. Malina i miód', bg: '#FCF7F4', surface: '#F7E6DF', surface2: '#F0D5CA', text: '#2F1E24', accent: '#8E3B4C', honey: '#DFA24F', sage: '#93B29A', sale: '#C2412D', dark: '#3B2229', fh: 'Quicksand', fhw: 700, fb: 'Work Sans', q: 'family=Quicksand:wght@400;500;600;700&family=Work+Sans:wght@400;500;600;700' },
      lawenda: { name: '4. Lawenda (jak Alia)', bg: '#FCFAFE', surface: '#F3ECFA', surface2: '#E7DAF4', text: '#2A2338', accent: '#8B6AB4', honey: '#C9A9DC', sage: '#9AB3A0', sale: '#B4532A', dark: '#3E3352', fh: 'EB Garamond', fhw: 500, fb: 'Mulish', q: 'family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Mulish:wght@400;500;600;700',
        extra: '.btn:not(.btn--outline):not(.btn--light):not(.btn--ghost-light){--btn-bg:#C9A9DC;--btn-bd:#C9A9DC;--btn-fg:#2A2338}.btn:not(.btn--outline):not(.btn--light):not(.btn--ghost-light):hover{--btn-bg:#B48FD2;--btn-bd:#B48FD2}.newsletter__badge,.cart-count,.steps li::before{background:#C9A9DC;color:#2A2338}.announcement,.announcement-bar{background:#C9A9DC;color:#2A2338}' }
    };
    var KEY = 'obex:paleta';
    var store = { get: function () { try { return sessionStorage.getItem(KEY); } catch (e) { return null; } }, set: function (v) { try { sessionStorage.setItem(KEY, v); } catch (e) {} } };
    var fromUrl = new URLSearchParams(location.search).get('paleta');
    if (fromUrl && P[fromUrl]) store.set(fromUrl);
    var root = document.documentElement;
    var initial = root.style.cssText;
    function rgb(h) { h = h.replace('#', ''); return [0, 2, 4].map(function (i) { return parseInt(h.substr(i, 2), 16); }); }
    function mix(a, b, p) { var x = rgb(a), y = rgb(b); return 'rgb(' + x.map(function (v, i) { return Math.round(v * p + y[i] * (1 - p)); }).join(',') + ')'; }
    function apply(id) {
      var p = P[id] || P.obecna;
      root.style.cssText = initial;
      var ex = document.getElementById('pal-extra'); if (!ex) { ex = document.createElement('style'); ex.id = 'pal-extra'; document.head.appendChild(ex); }
      ex.textContent = p.extra || '';
      if (!p.bg) return;
      var s = root.style;
      s.setProperty('--c-bg', p.bg); s.setProperty('--c-surface', p.surface); s.setProperty('--c-surface-2', p.surface2);
      s.setProperty('--c-text', p.text); s.setProperty('--c-text-rgb', rgb(p.text).join(', '));
      s.setProperty('--c-muted', mix(p.text, p.bg, 0.78)); s.setProperty('--c-line', mix(p.text, p.bg, 0.14));
      s.setProperty('--c-accent', p.accent); s.setProperty('--c-accent-contrast', '#FFFFFF');
      s.setProperty('--c-honey', p.honey); s.setProperty('--c-sage', p.sage); s.setProperty('--c-sale', p.sale); s.setProperty('--c-dark', p.dark);
      s.setProperty('--font-heading', "'" + p.fh + "', Georgia, serif"); s.setProperty('--font-heading-weight', p.fhw);
      s.setProperty('--font-body', "'" + p.fb + "', system-ui, sans-serif");
      var link = document.getElementById('pal-fonts-' + id);
      if (!link) { link = document.createElement('link'); link.id = 'pal-fonts-' + id; link.rel = 'stylesheet'; link.href = 'https://fonts.googleapis.com/css2?' + p.q + '&display=swap'; document.head.appendChild(link); }
    }
    var current = store.get() || 'obecna';
    apply(current);
    document.addEventListener('DOMContentLoaded', function () {
      var box = document.createElement('div'); box.className = 'pal-switch';
      var list = document.createElement('div'); list.className = 'pal-switch__list';
      Object.keys(P).forEach(function (id) {
        var p = P[id], b = document.createElement('button'); b.type = 'button'; b.className = 'pal-switch__opt'; b.dataset.id = id;
        var cols = p.bg ? [p.bg, p.surface, p.accent, p.honey, p.dark] : ['#F7F3EE', '#EFE8DF', '#5C4332', '#C89B7B', '#2A1F17'];
        b.innerHTML = '<span class="pal-switch__dots">' + cols.map(function (c) { return '<i style="background:' + c + '"></i>'; }).join('') + '</span><span>' + p.name + '</span>';
        b.setAttribute('aria-pressed', String(id === current));
        b.addEventListener('click', function () { current = id; store.set(id); apply(id); list.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', String(x.dataset.id === id)); }); });
        list.appendChild(b);
      });
      var t = document.createElement('button'); t.type = 'button'; t.className = 'pal-switch__toggle'; t.textContent = 'Kolory: zmień';
      t.addEventListener('click', function () { box.classList.toggle('is-open'); });
      box.appendChild(list); box.appendChild(t); document.body.appendChild(box);
    });
  })();
</script>
{%- endunless -%}
